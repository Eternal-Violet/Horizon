{
    "ai": {
      "provider": "minimax",
      "model": "MiniMax-M3",
      "api_key_env": "MINIMAX_API_KEY",
      "base_url": "https://api.minimaxi.com/v1",
      "temperature": 0.3,
      "max_tokens": 8192,
      "throttle_sec": 4.5,
      "languages": ["zh"]
    },
    "processing": {
      "profiles_dir": "profiles",
      "default_profile": "tech-news",
      "profile_settings": {
        "tech-news": { "threshold": 6.0, "topic_dedup": true },
        "tech-blog": { "threshold": 4.0, "topic_dedup": false }
      }
    },
    "sources": {
      "hackernews": {
        "enabled": true,
        "fetch_top_stories": 30,
        "min_score": 100,
        "profile": "tech-news"
      },
      "reddit": {
        "enabled": true,
        "subreddits": [
          { "subreddit": "MachineLearning", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15,
  "min_score": 50, "profile": "tech-news" },
          { "subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15,
  "min_score": 30, "profile": "tech-news" }
        ],
        "users": [],
        "fetch_comments": 5
      },
      "rss": [
        { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category":
  "ai-tools", "profile": "tech-news" },
        { "name": "OpenAI Blog", "url": "https://openai.com/blog/rss.xml", "enabled": true, "category": "ai-official",
  "profile": "tech-news" },
        { "name": "Anthropic Blog", "url": "https://www.anthropic.com/feed.xml", "enabled": true, "category":
  "ai-official", "profile": "tech-news" }
      ],
      "github": [
        { "type": "repo_releases", "owner": "openai", "repo": "whisper", "enabled": true, "profile": "tech-news" },
        { "type": "repo_releases", "owner": "anthropics", "repo": "claude-code", "enabled": true, "profile": "tech-news"
  }
      ]
    },
    "collection": { "time_window_hours": 24 },
    "digest": {
      "max_items": null,
      "profile_order": ["tech-news", "tech-blog"],
      "category_groups": {},
      "default_group": "other",
      "default_group_limit": null
    },
    "webhook": { "enabled": false, "platform": "generic" }
  }
